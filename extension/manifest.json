{
  "manifest_version": 3,
  "name": "Cinder Connect",
  "version": "0.1.0",
  "description": "Bind Firefox to one exact Windows process identity.",
  "permissions": ["nativeMessaging", "storage"],
  "action": {
    "default_title": "Cinder Connect",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cinder-connect@crazytaxzi.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
