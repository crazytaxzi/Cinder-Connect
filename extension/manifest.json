{
  "manifest_version": 3,
  "name": "Cinder Connect",
  "version": "0.2.0",
  "description": "Bridge one exact bound terminal process to a ChatGPT conversation in Firefox.",
  "permissions": ["nativeMessaging", "storage"],
  "action": {
    "default_title": "Cinder Connect",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "cinder-connect@crazytaxzi.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
